{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "typecheck": "tsc --noEmit",
    "build": "vite build && bun run typecheck",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "bun run lint && bun run typecheck && bun run test && bun run build",
    "db:migrate": "node scripts/migrate-postgres.mjs",
    "db:check": "node scripts/check-postgres.mjs",
    "db:import:dry-run": "node scripts/import-from-supabase.mjs",
    "db:import:apply": "node scripts/import-from-supabase.mjs --apply",
    "parts:check": "node scripts/sync-beyblade-parts.mjs --check",
    "parts:update": "node scripts/sync-beyblade-parts.mjs --write",
    "parts:database": "node scripts/sync-beyblade-parts.mjs --check-database",
    "parts:canonical:dry-run": "node scripts/migrate-canonical-beyblade-parts.mjs",
    "parts:canonical:apply": "node scripts/migrate-canonical-beyblade-parts.mjs --apply"
  },
  "dependencies": {
    "@lovable.dev/cloud-auth-js": "^1.1.2",
    "@supabase/supabase-js": "^2.110.9",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/react-query": "^5.101.1",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-start": "^1.168.26",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/qrcode": "^1.5.6",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.3.4",
    "vite-tsconfig-paths": "^6.0.2",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@lovable.dev/vite-tanstack-config": "2.9.1",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "nitro": "3.0.260603-beta",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.16",
    "vitest": "^3.2.4"
  }
}
